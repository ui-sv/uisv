{
	"name": "uisv",
	"version": "0.0.27",
	"description": "ui library for the rest of us",
	"license": "MIT",
	"repository": "ui-sv/uisv",
	"homepage": "https://uisv.pages.dev",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./contexts": {
			"types": "./dist/contexts.d.ts",
			"svelte": "./dist/contexts.js",
			"default": "./dist/contexts.js"
		},
		"./date": {
			"types": "./dist/date.d.ts",
			"svelte": "./dist/date.js",
			"default": "./dist/date.js"
		},
		"./mode": {
			"types": "./dist/mode.d.ts",
			"svelte": "./dist/mode.js",
			"default": "./dist/mode.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"svelte": "./dist/vite.js",
			"default": "./dist/vite.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.133",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"rehype-autolink-headings": "^7.1.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.19.2",
		"colortranslator": "^6.1.1",
		"dedent": "^1.7.2",
		"defu": "^6.1.7",
		"maska": "^3.2.1",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.2.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-variants": "^3.3.1",
		"theme-colors": "^0.1.0",
		"unocss": "^66.10.5"
	},
	"patchedDependencies": {
		"svelte@5.57.0": "patches/svelte@5.57.0.patch"
	}
}
